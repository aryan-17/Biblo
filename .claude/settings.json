{
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(cat:*)",
      "Bash(swiftc:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcodegen:*)",
      "Bash(xcrun:*)",
      "Bash(open:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm install:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Edit(apps/**)",
      "Edit(releases/**)",
      "Edit(.github/**)",
      "Edit(PLAN.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // \"\"' 2>/dev/null); echo \"$file\" | grep -qE '\\.(ts|tsx)$' && cd /Users/ctme/Documents/projects/biblo/apps/web && npx tsc --noEmit 2>&1 | head -20 || true",
            "statusMessage": "tsc...",
            "async": true
          }
        ]
      }
    ]
  }
}
